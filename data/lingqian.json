[{"n":1,"title":"钟离成道","level":"上签","gong":"子宫","poem":["开天辟地作良缘","吉日良时万物全","若得此签非小可","人行忠正帝王宣"],"shiyi":"此卦盘古初开天地之象。诸事皆吉也。","jie":"急速兆速。年未值时。观音降笔。先报君知。","xianji":[["家宅","祈福"],["自身","秋冬大利"],["求财","秋冬大利"],["交易","成"],["婚姻","成"],["六甲","生男"],["行人","至"],["田蚕","好"],["六畜","好"],["寻人","见"],["公讼","吉"],["移徙","—"],["失物","东北"],["疾病","设送"],["山坟","吉"]]},{"n":2,"title":"苏秦不第","level":"下签","gong":"子宫","poem":["鲸鱼未变守江河","不可升腾更望高","异日峥嵘身变化","许君一跃跳龙门"],"shiyi":"此卦鲸鱼未变之象。凡事忍耐待时也。","jie":"得忍且忍。得耐且耐。须待时至。功名还在。","xianji":[["家宅","不安"],["自身","还愿"],["求财","欠利"],["交易","难"],["婚姻","难"],["六甲","作福"],["行人","平安"],["田蚕","吉"],["六畜","不利"],["寻人","见"],["公讼","和"],["移徙","去"],["失物","东南"],["疾病","祈保"],["山坟","吉"]]},{"n":3,"title":"董永卖身","level":"下签","gong":"子宫","poem":["临风冒雨去还乡","正是其身似燕儿","衔得坭来欲作垒","到头垒坏复须泥"],"shiyi":"此卦燕子衔坭之象。凡事劳心费力也。","jie":"千般用计。晨昏不停。谁知此事。到底劳心。","xianji":[["家宅","先凶后吉"],["自身","谨防"],["求财","有"],["交易","成"],["婚姻","不合"],["六甲","男"],["行人","吉"],["田蚕","利"],["六畜","利"],["寻人","见"],["公讼","有理"],["移徙","安"],["失物","见"],["疾病","还愿"],["山坟","吉"]]},{"n":4,"title":"玉莲会十朋","level":"上签","gong":"子宫","poem":["千年古镜复重圆","女再求夫男再婚","自此门庭重改换","更添福禄在儿孙"],"shiyi":"此卦古镜重圆之象。凡事劳心有贵也。","jie":"淘沙见金。骑龙踏虎。虽是劳心。于中有补。","xianji":[["家宅","欠利"],["自身","秋冬旺"],["求财","秋冬旺"],["交易","允"],["婚姻","成"],["六甲","祈保"],["行人","至"],["田蚕","可养"],["六畜","可养"],["寻人","见"],["公讼","不利"],["移徙","守旧"],["失物","迟见"],["疾病","祈福"],["山坟","吉"]]},{"n":5,"title":"刘晨遇仙","level":"中签","gong":"丑宫","poem":["一锥凿地要求泉","努力求之得最难","无意偶然遇知己","相逢携手上青天"],"shiyi":"此卦锥地求泉之象。凡事先难后易也。","jie":"欲望心事。西方可求。不如莫动。立地可谋。","xianji":[["家宅","祈福"],["自身","利"],["求财","利"],["交易","合"],["婚姻","合"],["六甲","安"],["行人","迟"],["田蚕","宜早种"],["六畜","损"],["寻人","见"],["公讼","宜和"],["移徙","吉"],["失物","不见"],["疾病","禳星"],["山坟","吉"]]},{"n":6,"title":"仁贵遇主","level":"中签","gong":"丑宫","poem":["投身岩下铜鸟居","须是还他大丈夫","拾得营谋谁可得","通行天地此人无"],"shiyi":"此卦投岩铜鸟之象。凡事宜顺吉之兆。","jie":"食用无余。身清喜贫。待时利乐。权与概人。","xianji":[["家宅","不利"],["自身","中吉"],["求财","中吉"],["交易","难"],["婚姻","平平"],["六甲","安"],["行人","近"],["田蚕","早种"],["六畜","损"],["寻人","见"],["公讼","有理"],["移徙","吉"],["失物","见"],["疾病","设送"],["山坟","安"]]},{"n":7,"title":"苏娘走难","level":"下签","gong":"丑宫","poem":["奔波阻隔重重险","带水拖坭去度山","更望他乡求用事","千乡万里未回还"],"shiyi":"此卦拖泥带水之象。凡事守旧则吉也。","jie":"退身可得。进步为难。只宜守旧。莫望高攀。","xianji":[["家宅","不利"],["自身","祈福"],["求财","秋冬吉"],["交易","平平"],["婚姻","祈福"],["六甲","祈福"],["行人","阻"],["田蚕","不利"],["六畜","不利"],["寻人","难"],["公讼","亏"],["移徙","吉"],["失物","不见"],["疾病","作福"],["山坟","不利"]]},{"n":8,"title":"斐度还带","level":"上签","gong":"丑宫","poem":["茂林松柏正兴旺","雨雪风霜总莫为","异日忽然成大用","功名成就栋梁材"],"shiyi":"此卦此卦松柏茂林之象。凡事有贵气也。","jie":"路上亨通。终身有功。田蚕丰熟。家道兴隆。","xianji":[["家宅","吉"],["自身","顺利"],["求财","中平"],["交易","旺"],["婚姻","成"],["六甲","男"],["行人","有信"],["田蚕","利"],["六畜","损"],["寻人","至"],["公讼","有理"],["移徙","吉"],["失物","见"],["疾病","安"],["山坟","吉"]]},{"n":9,"title":"孔明点将","level":"中签","gong":"寅宫","poem":["烦君勿作私心事","此意偏宜说问公","一片明心光皎洁","宛如皎月正天中"],"shiyi":"此卦皎月当空之象。凡事光明通达也。","jie":"心中正直。理顺法宽。圣无私语。终有分明。","xianji":[["家宅","吉"],["自身","顺"],["求财","中平"],["交易","旺"],["婚姻","成"],["六甲","男"],["行人","动"],["田蚕","利"],["六畜","损"],["寻人","至"],["公讼","有理"],["移徙","吉"],["失物","祈福"],["疾病","安"],["山坟","吉"]]},{"n":10,"title":"庞涓观阵","level":"中签","gong":"寅宫","poem":["石藏无价玉和珍","只管他乡外客寻","宛如持灯更觅火","不如收拾枉劳心"],"shiyi":"此卦持灯觅火之象。凡事待时成就也。","jie":"姻缘会遇。何事不成。须无限意。眼前是真。","xianji":[["家宅","欠利"],["自身","安"],["求财","难"],["交易","难"],["婚姻","合"],["六甲","女"],["行人","动"],["田蚕","秋吉"],["六畜","难养"],["寻人","见"],["公讼","亏"],["移徙","旧安"],["失物","难见"],["疾病","设送"],["山坟","中平"]]},{"n":11,"title":"书荐姜维","level":"上签","gong":"寅宫","poem":["欲求胜事可非常","争奈亲姻日暂忙","到头竟必成中箭","贵人指引贵人乡"],"shiyi":"此卦因祸得福之象。凡事营谋吉利也。","jie":"有意兴变。到底安然。若问用事。只近贵人。","xianji":[["家宅","大吉"],["自身","顺利"],["求财","有"],["交易","成"],["婚姻","合"],["六甲","男"],["行人","未至"],["田蚕","中平"],["六畜","中平"],["寻人","见"],["公讼","有理"],["移徙","旺"],["失物","东方"],["疾病","禳星"],["山坟","吉"]]},{"n":12,"title":"武吉遇师","level":"上签","gong":"寅宫","poem":["否去泰来咫尺间","暂交君子出于山","若逢虎兔佳音信","立志忙中事即闲"],"shiyi":"此卦祸中有福之象。凡事先凶后吉也。","jie":"换麻得丝。击人双足。要见分明。因灾得福。","xianji":[["家宅","安"],["自身","吉"],["求财","有"],["交易","宜迟"],["婚姻","成"],["六甲","男"],["行人","未回"],["田蚕","利"],["六畜","慎吉"],["寻人","有信"],["公讼","吉"],["移徙","守旧"],["失物","见"],["疾病","秋吉"],["山坟","吉"]]},{"n":13,"title":"罗通拜帅","level":"中签","gong":"寅宫","poem":["自小生在富贵家","眼前万物总奢华","蒙君赐紫金腰带","四海声名定可夸"],"shiyi":"此卦龙门得遇之象。凡事有变大吉也。","jie":"囚人逢赦。病即安然。龙门得遇。名遍皇都。","xianji":[["家宅","祈福"],["自身","祈福"],["求财","秋冬吉"],["交易","宜迟"],["婚姻","合"],["六甲","女"],["行人","祈保"],["田蚕","中平"],["六畜","中平"],["寻人","见"],["公讼","有理"],["移徙","守旧"],["失物","东方"],["疾病","安"],["山坟","吉"]]},{"n":14,"title":"子牙弃官","level":"中签","gong":"卯宫","poem":["宛如仙鹤出樊笼","脱得樊笼路路通","南北东西无阻隔","任君直上九霄宫"],"shiyi":"此卦仙鹤离笼之象。凡事先凶后吉也。","jie":"任意无虞。路有亨通。随心自在。逍遥如人。","xianji":[["家宅","不安"],["自身","还愿"],["求财","合"],["交易","合"],["婚姻","合"],["六甲","男"],["行人","见"],["田蚕","秋利"],["六畜","损"],["寻人","阻"],["公讼","宜和"],["移徙","吉"],["失物","东南"],["疾病","设送"],["山坟","吉"]]},{"n":15,"title":"苏秦得志","level":"中签","gong":"卯宫","poem":["行人怨日气难吞","忽有灾事勿近前","巢破林鸟无所宿","可寻深处稳安身"],"shiyi":"此卦鸟鹊离林之象。凡事到底应心也。","jie":"若人得怨。何时可伸。好言不信。守旧待时。","xianji":[["家宅","先凶后吉"],["自身","谨防"],["求财","吉"],["交易","成"],["婚姻","阻滞"],["六甲","男"],["行人","顺"],["田蚕","利"],["六畜","旺"],["寻人","见"],["公讼","有理"],["移徙","难"],["失物","难见"],["疾病","还愿"],["山坟","吉"]]},{"n":16,"title":"叶梦熊朝帝","level":"中签","gong":"卯宫","poem":["愁眉思虑暂时开","启出云霄喜自来","宛如粪土中藏玉","良工荐举出尘埃"],"shiyi":"此卦阴阳和合之象。凡所谋皆吉也。","jie":"得处无失。损中有益。小人逢凶。君子顺吉。","xianji":[["家宅","不利"],["自身","秋冬吉"],["求财","成"],["交易","成"],["婚姻","成"],["六甲","虚惊"],["行人","至"],["田蚕","祈福"],["六畜","平"],["寻人","见"],["公讼","不利"],["移徙","守旧"],["失物","阻"],["疾病","作福"],["山坟","安"]]},{"n":17,"title":"话梅止渴","level":"中签","gong":"卯宫","poem":["莫听闲言说是非","晨昏只好念阿弥","若将狂话为真实","画饼如何止得饥"],"shiyi":"此卦画饼充饥之象。诸事多虚少实也。","jie":"心中不定。枉看经文。恰似画饼。食也难吞。","xianji":[["家宅","祈福"],["自身","顺利"],["求财","顺利"],["交易","顺利"],["婚姻","阻"],["六甲","安"],["行人","迟"],["田蚕","宜早种"],["六畜","不利"],["寻人","见"],["公讼","和"],["移徙","守旧"],["失物","不见"],["疾病","还愿"],["山坟","吉"]]},{"n":18,"title":"曹国舅为仙","level":"上签","gong":"卯宫","poem":["金乌西坠兔东升","日夜循环至古今","僧道得知无不利","士农工商各从心"],"shiyi":"此卦阴阳消长之象。凡事遂意之兆也。","jie":"心中无事。所作有功。如弓上箭。一发当空。","xianji":[["家宅","安"],["自身","吉"],["求财","顺"],["交易","成"],["婚姻","合"],["六甲","男"],["行人","至"],["田蚕","早种"],["六畜","欠利"],["寻人","至"],["公讼","有理"],["移徙","吉"],["失物","迟见"],["疾病","拜送"],["山坟","大吉"]]},{"n":19,"title":"子仪封王","level":"中签","gong":"辰宫","poem":["急水滩头放船归","风波作浪欲何为","若要安然求稳静","等待浪静过此危"],"shiyi":"此卦船行急滩之象。凡事守旧待时也。","jie":"急水下船。险处待时。若问营谋。尽可施为。","xianji":[["家宅","作福"],["自身","作福"],["求财","未成"],["交易","未成"],["婚姻","不就"],["六甲","虚惊"],["行人","至"],["田蚕","吉"],["寻人","难"],["公讼","和"],["移徙","守旧"],["失物","难寻"],["疾病","祈福"],["山坟","吉"]]},{"n":20,"title":"姜太公遇文王","level":"中签","gong":"辰宫","poem":["当春久雨喜开晴","玉兔金乌渐渐明","旧事消散新事遂","看看一跳过龙门"],"shiyi":"此卦久雨初明之象。凡事遂意也。","jie":"神佛护持。有灾无危。途生平安。到底荣归。","xianji":[["家宅","中平"],["自身","祈福"],["求财","未遇"],["交易","待时"],["婚姻","随意"],["六甲","女"],["行人","阻"],["田蚕","阻"],["六畜","阻"],["寻人","迟"],["公讼","和"],["移徙","吉"],["失物","见"],["疾病","禳星"],["山坟","吉"]]},{"n":21,"title":"李旦龙凤配合","level":"上签","gong":"辰宫","poem":["阴阳道合总由天","女嫁男婚喜偎然","但见龙蛇相会合","熊罴入梦乐团圆"],"shiyi":"此卦阴阳道合之象。凡事和合大吉也。","jie":"谋望从心。婚姻孕男。资财进益。更利田蚕。","xianji":[["家宅","安"],["自身","利"],["求财","有"],["交易","成"],["婚姻","合"],["六甲","男"],["行人","至"],["田蚕","兴"],["六畜","兴"],["寻人","见"],["公讼","有理"],["移徙","昌盛"],["失物","得见"],["疾病","遇良方"],["山坟","大吉"]]},{"n":22,"title":"六郎逢救","level":"中签","gong":"已宫","poem":["旱时田里皆枯藁","谢天甘雨落淋淋","花果草木皆润泽","始知一雨值千金"],"shiyi":"此卦旱逢甘雨之象。凡事难中有救也。","jie":"田蚕倍熟。命运渐来。病遇良药。行人便回。","xianji":[["家宅","祈保"],["自身","安"],["求财","颇有"],["交易","迟"],["婚姻","合"],["六甲","女"],["行人","有阻"],["田蚕","利"],["六畜","利"],["寻人","难"],["公讼","亏"],["移徙","守旧"],["失物","西方"],["疾病","设送"],["山坟","安吉"]]},{"n":23,"title":"怀德招亲","level":"中签","gong":"已宫","poem":["欲扳仙桂入蟾宫","岂虑天门不任君","忽遇一般音信好","人人皆笑岭顶花"],"shiyi":"此卦手扳仙桂之象。凡事必有贵人也。","jie":"商贾利益。行藏有危。病安讼遂。尽可施为。","xianji":[["家宅","欠安"],["自身","作福"],["求财","遂意"],["交易","合"],["婚姻","阻"],["六甲","作福"],["行人","有危"],["田蚕","不利"],["六畜","不利"],["寻人","难"],["公讼","亏"],["移徙","欠吉"],["失物","见"],["疾病","安"],["山坟","旧吉"]]},{"n":24,"title":"殷郊遇师","level":"下签","gong":"已宫","poem":["不成理论不成家","水性痴人似落花","若问君恩须得力","到头方见事如麻"],"shiyi":"此卦痴人道塞之象。凡事守旧待时也。","jie":"是非莫说。必须仔细。心正理直。方免灾危。","xianji":[["家宅","不安"],["自身","险"],["求财","阻"],["交易","难"],["婚姻","待时"],["六甲","祈福"],["行人","阻"],["田蚕","多灾"],["六畜","多灾"],["寻人","阻"],["公讼","亏"],["移徙","吉"],["失物","难见"],["疾病","急求神"],["山坟","不吉"]]},{"n":25,"title":"李广机智","level":"中签","gong":"已宫","poem":["过了忧危事几重","从今再立永无空","宽心自有宽心计","得遇高人立大功"],"shiyi":"此卦古井逢泉之象。凡事贵人成就也。","jie":"讼终有理。病得安全。出入求谋。古井逢泉。","xianji":[["家宅","平平"],["自身","阻滞"],["求财","阻滞"],["交易","阻滞"],["婚姻","和合"],["六甲","有险"],["行人","阻隔"],["田蚕","不利"],["六畜","不利"],["寻人","阻隔"],["公讼","有理"],["移徙","不合"],["失物","难寻"],["疾病","祈福"],["山坟","不安"]]},{"n":26,"title":"钟馗得道","level":"中签","gong":"已宫","poem":["上下传来事转虚","天边接得一封书","书中许我功名遂","直到终时亦是虚"],"shiyi":"此卦虚名之象。凡事虚多少实宜守旧也。","jie":"上下心烦。求闲不闲。欲望功名。守旧身安。","xianji":[["家宅","祈福"],["自身","安"],["求财","阻"],["交易","不成"],["婚姻","不成"],["六甲","女"],["行人","有信"],["田蚕","半熟"],["六畜","可养"],["寻人","西方"],["公讼","亏"],["移徙","守旧"],["失物","难"],["疾病","祈保"],["山坟","吉"]]},{"n":27,"title":"刘基谏主","level":"中签","gong":"午宫","poem":["一谋一用一番书","虑后思前不敢为","时到贵人相助力","如山壁立可安居"],"shiyi":"此卦屋好墙壁之象。凡事稳当无险也。","jie":"改旧成新。寒花遇春。从前阻滞。今得称心。","xianji":[["家宅","安"],["自身","吉"],["求财","有"],["交易","难"],["婚姻","阻"],["六甲","女"],["行人","迟"],["田蚕","熟"],["六畜","利"],["寻人","迟"],["公讼","宜和"],["移徙","吉"],["失物","无踪"],["疾病","延安"],["山坟","守旧大吉"]]},{"n":28,"title":"李后寻包公","level":"中签","gong":"午宫","poem":["东边月上正婵娟","顷刻云遮亦暗存","或有圆时还有缺","更言非者亦闲言"],"shiyi":"此卦月被云遮之象。凡事昏迷未定也。","jie":"浮云遮月。不须疑惑。等待云收。便见明白。","xianji":[["家宅","不安"],["自身","祈保"],["求财","阻"],["交易","吉"],["婚姻","不合"],["六甲","有惊"],["行人","滞"],["田蚕","不利"],["六畜","不利"],["寻人","难"],["公讼","亏"],["移徙","守旧"],["失物","西方"],["疾病","难痊"],["山坟","改"]]},{"n":29,"title":"赵子龙救阿斗","level":"中签","gong":"午宫","poem":["宝剑出匣耀光明","在匣全然不惹尘","今得贵人携出现","有威有势众人钦"],"shiyi":"此卦宝剑出匣之象。凡事有威有势也。","jie":"宝剑出匣。光辉万里。贵人指引。无不观美。","xianji":[["家宅","祈福"],["自身","吉"],["求财","利"],["交易","成"],["婚姻","好"],["六甲","女"],["行人","迟"],["田蚕","宜早"],["六畜","损"],["寻人","见"],["公讼","和"],["移徙","兴"],["失物","南方"],["疾病","还旧愿"],["山坟","吉"]]},{"n":30,"title":"棋盘大会","level":"中签","gong":"午宫","poem":["劝君切莫向他求","似鹤飞来暗箭投","若去采薪蛇在草","恐遭毒口也忧愁"],"shiyi":"此卦安份守己之象。凡事小心谨防也。","jie":"闭口含齿。他事莫理。若有亏心。到头害己。","xianji":[["家宅","安"],["自身","平平"],["求财","待时"],["交易","滞"],["婚姻","未许"],["六甲","虚惊"],["行人","阻隔"],["田蚕","不利"],["六畜","不利"],["寻人","阻隔"],["公讼","亏"],["移徙","守旧"],["失物","不见"],["疾病","难痊"],["山坟","大吉"]]},{"n":31,"title":"佛印会东坡","level":"中签","gong":"未宫","poem":["清闲无忧静处坐","饱后吃茶时坐卧","放下身心不用忙","必定不招冤与祸"],"shiyi":"此卦守旧安然之象。凡事时待时则吉也。","jie":"守旧安然。叩问神仙。直待时来。事亦偶然。","xianji":[["家宅","祈保"],["自身","安"],["求财","守待"],["交易","宜迟"],["婚姻","合"],["六甲","女"],["行人","至"],["田蚕","秋熟"],["六畜","稳"],["寻人","难"],["公讼","和"],["移徙","吉"],["失物","虚"],["疾病","设送"],["山坟","吉"]]},{"n":32,"title":"刘备求贤","level":"中签","gong":"未宫","poem":["前程杳杳定无疑","石中藏玉有谁知","一朝良匠分明剖","始觉安然碧玉期"],"shiyi":"此卦剖石见玉之象。凡事着力成功也。","jie":"宝在石中。异人少知。直待分明。尽可施为。","xianji":[["家宅","平平"],["自身","安"],["求财","劳力"],["交易","阻"],["婚姻","成"],["六甲","虚"],["行人","杳"],["田蚕","晚成"],["六畜","旺"],["寻人","见"],["公讼","惊"],["移徙","改"],["失物","西方"],["疾病","欠安"],["山坟","改向吉"]]},{"n":33,"title":"咬金聘仁贵","level":"中签","gong":"未宫","poem":["内藏无价宝和珍","得玉何须外界寻","不如等待高人识","宽心犹且更宽心"],"shiyi":"此卦藏玉内寻之象。凡事待时可也。","jie":"内藏金玉。何必外寻。遇贵指引。不须劳心。","xianji":[["家宅","祈保"],["自身","安"],["求财","守待"],["交易","迟"],["婚姻","就"],["六甲","男"],["行人","阻"],["田蚕","半熟"],["六畜","旺"],["寻人","劳"],["公讼","搁"],["移徙","吉"],["失物","北方"],["疾病","遇良医"],["山坟","宜改"]]},{"n":34,"title":"桃园结义","level":"中签","gong":"未宫","poem":["行藏出入礼义恭","言必忠良信必从","心不了然且静澈","光明红日正当中"],"shiyi":"此卦红日当空正照之象。凡事遂意也。","jie":"心中无事。秋水澄清。不须疑惑。事自然成。","xianji":[["家宅","清吉"],["自身","安"],["求财","虚"],["交易","难"],["婚姻","合"],["六甲","有险"],["行人","阻"],["田蚕","不利"],["六畜","衰"],["寻人","滞"],["公讼","亏"],["移徙","守旧"],["失物","虚"],["疾病","设送"],["山坟","大吉"]]},{"n":35,"title":"唐僧取经","level":"中签","gong":"申宫","poem":["衣冠重整旧家风","道是无穹却有功","扫却当途荆棘刺","三人约议再和同"],"shiyi":"此卦衣冠重整之象。凡事先难后易也。","jie":"不用忧疑。自有佳期。若问前程。前路可宜。","xianji":[["家宅","乱"],["自身","吉"],["求财","好"],["交易","利"],["婚姻","阻"],["六甲","惊"],["行人","至"],["田蚕","不利"],["六畜","兴"],["寻人","至"],["公讼","有理"],["移徙","安"],["失物","迟见"],["疾病","祈福"],["山坟","宜旧"]]},{"n":36,"title":"湘子遇宾","level":"中签","gong":"申宫","poem":["眼前病讼不须忧","满地资财尽可求","恰似猿猴金锁脱","自归山洞去来游"],"shiyi":"此卦猿猴脱锁之象。凡事先难后易也。","jie":"脱除了事。且自宽心。待得时来。堪寻正路。","xianji":[["家宅","不安"],["自身","安"],["求财","大利"],["交易","待时"],["婚姻","未成"],["六甲","祈保"],["行人","至"],["田蚕","十足"],["六畜","平"],["寻人","至"],["公讼","有理"],["移徙","吉"],["失物","远"],["疾病","欠安"],["山坟","吉"]]},{"n":37,"title":"李靖归山","level":"中签","gong":"申宫","poem":["欲待身安动泰时","风中灯烛不相宜","不如收拾深堂坐","庶免光摇静处明"],"shiyi":"此卦风摇灯烛之象。凡事守常则吉也。","jie":"静处安身。待命守时。支惹非福。守旧相宜。","xianji":[["家宅","守旧"],["自身","平平"],["求财","有"],["交易","难"],["婚姻","不合"],["六甲","祈保"],["行人","有信"],["田蚕","秋熟"],["六畜","安"],["寻人","见"],["公讼","和"],["移徙","守旧"],["失物","难"],["疾病","禳星"],["山坟","勿改"]]},{"n":38,"title":"何文秀遇难","level":"下签","gong":"申宫","poem":["月照天书静处期","忽遭云雾又昏迷","宽心祈待云霞散","此时更改好施为"],"shiyi":"此卦云雾遮月之象。凡事未遂守旧也。","jie":"家道忧凶。人口有灾。祈福保庆。犹恐破财。","xianji":[["家宅","不安"],["自身","祈保"],["求财","难"],["交易","待时"],["婚姻","难合"],["六甲","虚惊"],["行人","阻"],["田蚕","损"],["六畜","损"],["寻人","遇"],["公讼","和"],["移徙","安"],["失物","虚"],["疾病","延安"],["山坟","宜修"]]},{"n":39,"title":"姜女寻夫","level":"下签","gong":"酉宫","poem":["天边消息实难思","切莫多心望强求","若把石头磨作镜","曾知枉费己功夫"],"shiyi":"此卦守常安静之象。凡事守己则吉也。","jie":"千般用计。枉费功夫。不如守旧。着甚来由。","xianji":[["家宅","安"],["自身","提防"],["求财","平平"],["交易","阻"],["婚姻","不合"],["六甲","女"],["行人","动"],["田蚕","利"],["六畜","损"],["寻人","难"],["公讼","亏"],["移徙","平"],["失物","空"],["疾病","送安"],["山坟","大吉"]]},{"n":40,"title":"武则天登位","level":"中签","gong":"酉宫","poem":["红轮西坠兔东升","阴长阳消百事亨","若是女人宜望用","增添财禄福其心"],"shiyi":"此卦阴长阳消之象。凡事先难后易也。","jie":"阴利女人。不宜男子。若是求谋。先凶后吉。","xianji":[["家宅","不利"],["自身","祈福"],["求财","守待"],["交易","吉"],["婚姻","不合"],["六甲","虚"],["行人","阻"],["田蚕","旺"],["六畜","旺"],["寻人","隔"],["公讼","亏"],["移徙","大吉"],["失物","空"],["疾病","有惊"],["山坟","大吉"]]},{"n":41,"title":"董卓收吕布","level":"中签","gong":"酉宫","poem":["无限好言君记取","却为认贼将作子","莫贪眼下有些甜","更虑他年前样看"],"shiyi":"此卦认贼作子之象。凡事认真防假。","jie":"只这一着。君子莫错。牢记在心。不生寂寞。","xianji":[["家宅","不安"],["自身","平常"],["求财","守待"],["交易","难"],["婚姻","未合"],["六甲","男惊"],["行人","至"],["田蚕","半熟"],["六畜","安"],["寻人","至"],["公讼","宜和"],["移徙","祈保"],["失物","难寻"],["疾病","禳星"],["山坟","中平"]]},{"n":42,"title":"目莲救母","level":"上签","gong":"酉宫","poem":["君皇圣后总为恩","复待祈禳无损增","一切有情皆受用","人间天上得期亨"],"shiyi":"此卦天垂恩泽之象。凡事成就大吉也。","jie":"天皇降恩。始终莫忘。晨昏礼佛。可宜烧香。","xianji":[["家宅","祈福"],["自身","冬吉"],["求财","未有"],["交易","成"],["婚姻","中吉"],["六甲","平安"],["行人","动"],["田蚕","中平"],["六畜","中平"],["寻人","见"],["公讼","胜"],["移徙","守旧"],["失物","空"],["疾病","解"],["山坟","安"]]},{"n":43,"title":"行者得道","level":"上签","gong":"戌宫","poem":["天地变通万物全","自营自养自安然","生罗万象皆精彩","事事如心谢圣贤"],"shiyi":"此卦大地交泰之象。凡事大吉无危也。","jie":"天生万物。谋望皆通。福德相助。瑞气匆匆。","xianji":[["家宅","吉"],["自身","安"],["求财","有"],["交易","利"],["婚姻","合"],["六甲","男"],["行人","有阻"],["田蚕","中平"],["六畜","中平"],["寻人","见"],["公讼","胜"],["移徙","利"],["失物","东西"],["疾病","禳星"],["山坟","东西吉"]]},{"n":44,"title":"姜维邓艾斗阵","level":"中签","gong":"戌宫","poem":["棋逢敌手着相宜","黑白盘中未决时","皆因一着知胜败","须教自有好推宜"],"shiyi":"此卦棋逢敌手之象。凡事用机关则吉也。","jie":"欲求心事。恰如围棋。到底胜利。宜用心机。","xianji":[["家宅","大利"],["自身","平稳"],["求财","遂"],["交易","利"],["婚姻","未合"],["六甲","女"],["行人","阻"],["田蚕","平"],["六畜","损"],["寻人","阻"],["公讼","宜和"],["移徙","守旧"],["失物","空"],["疾病","祈保"],["山坟","守旧"]]},{"n":45,"title":"仁宗认母","level":"上签","gong":"戌宫","poem":["温柔自古胜刚强","积善之门大吉昌","若是有人占此卦","宛如正渴遇瑶浆"],"shiyi":"此卦积善温柔之象。凡事贵人和合也。","jie":"天地有感。应验非常。佛神护佑。得之莫忘。","xianji":[["家宅","吉"],["自身","安"],["求财","遂"],["交易","利"],["婚姻","合"],["六甲","男"],["行人","阻"],["田蚕","秋利"],["六畜","中平"],["六畜","中平"],["寻人","见"],["公讼","胜"],["移徙","利"],["失物","东方"],["疾病","祈福"],["山坟","东西向吉"]]},{"n":46,"title":"渭水钓鱼","level":"中签","gong":"戌宫","poem":["劝君耐守旧生涯","把定心肠勿起歹","直待有人轻着力","枯枝老树再生花"],"shiyi":"此卦枯木生花之象。凡事自有成就也。","jie":"守旧守静。事自成就。动则多殃。静则无咎。","xianji":[["家宅","安"],["自身","吉"],["求财","待时"],["交易","成"],["婚姻","就"],["六甲","生女"],["行人","阻"],["田蚕","五分"],["六畜","难"],["寻人","杳"],["公讼","吉"],["移徙","守旧"],["失物","空"],["疾病","求福"],["山坟","吉"]]},{"n":47,"title":"梁灏登科","level":"上签","gong":"亥宫","poem":["锦上添花色愈鲜","运来禄马喜双全","时人莫恨功名晚","一举登科四海传"],"shiyi":"此卦锦上添花之象。凡事大吉大利也。","jie":"守旧变新。运至功成。遂平生志。尽皆是命。","xianji":[["家宅","祈保"],["自身","安"],["求财","利"],["交易","阻"],["婚姻","合"],["六甲","生男"],["行人","迟"],["田蚕","八分"],["六畜","平"],["寻人","至"],["公讼","宜和"],["移徙","吉"],["失物","西北"],["疾病","作福"],["山坟","利"]]},{"n":48,"title":"韩信挂帅","level":"中签","gong":"亥宫","poem":["昆鸟秋来化作鹏","好游快乐喜飞腾","翱翔万里云霄去","余外诸禽总不能"],"shiyi":"此卦昆鹏兴变之象。凡事有变动大吉。","jie":"昆化为鹏。万禽不能。桂香一折。福禄自增。","xianji":[["家宅","利"],["自身","吉"],["求财","秋旺"],["交易","迟"],["婚姻","不合"],["六甲","安"],["行人","阻滞"],["田蚕","中平"],["六畜","春利"],["寻人","见"],["公讼","胜"],["移徙","守旧"],["失物","西"],["疾病","祈保"],["山坟","安"]]},{"n":49,"title":"王祥求鲤","level":"中签","gong":"亥宫","poem":["天寒地冻水成冰","何须贪吝取功名","只好守己静处坐","待时兴变自然明"],"shiyi":"此卦水结成冰之象。凡事不用枉求也。","jie":"水结成冰。冰消成水。若是营谋。到底如是。","xianji":[["家宅","不安"],["自身","祈保"],["求财","难"],["交易","阻"],["婚姻","不合"],["六甲","险"],["行人","迟"],["田蚕","亏"],["六畜","损"],["寻人","见"],["公讼","和"],["移徙","守旧"],["失物","空"],["疾病","难痊"],["山坟","大吉"]]},{"n":50,"title":"陶朱归五湖","level":"中签","gong":"亥宫","poem":["五湖四海任君行","高挂帆蓬自在撑","若得顺风随即至","满船宝贝喜层层"],"shiyi":"此卦顺风撑船之象。凡事皆顺大吉也。","jie":"自在休悠。不须着力。财禄重重。无不欣美。","xianji":[["家宅","利"],["自身","吉"],["求财","利西"],["交易","宜迟"],["婚姻","不合"],["六甲","安"],["行人","阻"],["田蚕","秋利"],["六畜","春旺"],["寻人","至"],["公讼","亏"],["移徙","守旧"],["失物","西方"],["疾病","解"],["山坟","南利"]]},{"n":51,"title":"孔明入川","level":"上签","gong":"子宫","poem":["夏日炎天日最长","人人愁热闷非常","天地也解知人意","熏风拂拂自然凉"],"shiyi":"此卦人人愁热之象。凡事随心从意也。","jie":"进退莫疑。自有佳期。营谋用度。不须妄为。","xianji":[["家宅","祈福"],["自身","谨防"],["求财","秋吉"],["交易","平常"],["婚姻","合"],["六甲","生男"],["行人","动"],["田蚕","损"],["六畜","平"],["寻人","见"],["公讼","吉"],["移徙","旧"],["失物","北方"],["疾病","还愿"],["山坟","吉"]]},{"n":52,"title":"太白醉捞明月","level":"中签","gong":"子宫","poem":["水中捞月费功夫","费尽功夫却又无","莫说闲言并乱语","枉劳心力强身枯"],"shiyi":"此卦贪求费力之象。凡事劳心费力也。","jie":"言语难思。费力劳心。宅中忧恼。待遇贵人。","xianji":[["家宅","不安"],["自身","欠吉"],["求财","中平"],["交易","难"],["婚姻","未就"],["六甲","祈保"],["行人","有灾"],["田蚕","五分"],["六畜","衰"],["寻人","至"],["公讼","和"],["移徙","平常"],["失物","难"],["疾病","祈保"],["山坟","吉"]]},{"n":53,"title":"刘备招亲","level":"中签","gong":"子宫","poem":["失意反成得意时","龙吟虎啸两相宜","青天自有通霄路","许我功名再有期"],"shiyi":"此卦龙吟虎啸之象。凡事顺意有望也。","jie":"教去即去。教住即住。自有亨通。到头必利。","xianji":[["家宅","不安"],["自身","欠吉"],["求财","中平"],["交易","难"],["婚姻","成就"],["六甲","祈保"],["行人","至"],["田蚕","五分"],["六畜","损"],["寻人","至"],["公讼","和"],["移徙","吉"],["失物","见"],["疾病","安"],["山坟","吉"]]},{"n":54,"title":"马超追曹","level":"下签","gong":"子宫","poem":["梦中得宝醒来无","自谓南山只是锄","若问婚姻并问病","别寻来路为相扶"],"shiyi":"此卦梦中得宝之象。凡事枉费心力也。","jie":"物在水中。形影长短。皆有分定。不用商量。","xianji":[["家宅","欠安"],["自身","谨防"],["求财","阻"],["交易","难"],["婚姻","待时"],["六甲","祈保"],["行人","迟"],["田蚕","滞"],["六畜","滞"],["寻人","见"],["公讼","亏"],["移徙","吉"],["失物","空"],["疾病","求神保佑"],["山坟","不安"]]},{"n":55,"title":"周武王登位","level":"中签","gong":"丑宫","poem":["父贤传子子传孙","衣食丰隆只靠天","堂上椿萱人快乐","饥饭渴饮困时眠"],"shiyi":"此卦接竹引泉之象。凡事谋望大吉也。","jie":"接竹引泉。流传不绝。君子谋望。无不欣悦。","xianji":[["家宅","欠安"],["自身","还愿"],["求财","利"],["交易","成"],["婚姻","合"],["六甲","平安"],["行人","动"],["田蚕","吉"],["六畜","损"],["寻人","难"],["公讼","有贵人"],["移徙","吉"],["失物","见"],["疾病","禳星"],["山坟","安"]]},{"n":56,"title":"禄山谋反","level":"中签","gong":"丑宫","poem":["滩小石溪流水响","清风明月贵人忙","路须借问何方去","莫取林中花草香"],"shiyi":"此卦船行小滩之象。凡事有贵人助也。","jie":"营谋用事。劳心费力。守旧待时。凡事大吉。","xianji":[["家宅","安"],["自身","吉"],["求财","中平"],["交易","利"],["婚姻","遂"],["六甲","男"],["行人","至"],["田蚕","秋利"],["六畜","损"],["寻人","至"],["公讼","有理"],["移徙","吉"],["失物","带"],["疾病","即安"],["山坟","宜修"]]},{"n":57,"title":"董仲寻亲","level":"中签","gong":"丑宫","poem":["说是说非风过耳","好衣好禄自然丰","君莫记取当年事","汝意还如我意同"],"shiyi":"此卦孩儿见母之象。诸事贵人大吉也。","jie":"所用谋望。皆大欢喜。从公用力。如子逢娘。","xianji":[["家宅","不安"],["自身","平平"],["求财","顺"],["交易","成"],["婚姻","合"],["六甲","女"],["行人","阻"],["田蚕","就"],["六畜","损"],["寻人","难"],["公讼","宜和"],["移徙","守旧"],["失物","空"],["疾病","祈福"],["山坟","吉"]]},{"n":58,"title":"文王问卜","level":"中签","gong":"丑宫","poem":["直言说话君须记","莫在他乡求别艺","切须守己旧生涯","除此其余都不利"],"shiyi":"此卦守旧待时之象。凡事守旧则吉也。","jie":"得住且住。可取且踞。莫宜别事。只宜守旧。","xianji":[["家宅","平常"],["自身","不利"],["求财","吉"],["交易","成"],["婚姻","阻"],["六甲","惊"],["行人","迟"],["田蚕","五分"],["六畜","损"],["寻人","见"],["公讼","亏"],["移徙","守旧"],["失物","凶"],["疾病","欠安"],["山坟","宜改"]]},{"n":59,"title":"张良隐山","level":"中签","gong":"寅宫","poem":["直上重楼去藏身","四围荆棘绕为林","天高君命长和短","得一番成失二人"],"shiyi":"此卦守旧随时之象。凡事待时则吉。","jie":"如醉饮酒。只宜守旧。直待时来。无灾无咎。","xianji":[["家宅","祈福"],["自身","安"],["求财","平常"],["交易","成"],["婚姻","不合"],["六甲","作福"],["行人","至"],["田蚕","半吉"],["六畜","大利"],["寻人","阻"],["公讼","亏"],["移徙","吉"],["失物","凶"],["疾病","祈福"],["山坟","吉"]]},{"n":60,"title":"赤壁鏖兵","level":"下签","gong":"寅宫","poem":["抱薪救火大皆燃","烧遍三千亦复然","若问荣华并出入","不如收拾枉劳心"],"shiyi":"此卦抱薪救火之象。凡事亦自谨防也。","jie":"有千般计。不如莫动。一旦相惹。恐祸归身。","xianji":[["家宅","凶"],["自身","祈保"],["求财","微微"],["交易","不合"],["婚姻","不合"],["六甲","险"],["行人","滞"],["田蚕","不利"],["六畜","损"],["寻人","杳"],["公讼","亏"],["移徙","吉"],["失物","西方"],["疾病","有惊"],["山坟","平平"]]},{"n":61,"title":"苏小妹难夫","level":"中签","gong":"寅宫","poem":["日落吟诗月下歌","逢场作戏笑呵呵","相逢会遇难藏避","唱彩齐唱连理罗"],"shiyi":"此卦守旧随时之象。凡事时吉利也。","jie":"佳人在屋。吟唱诗曲。一片欢心。命中祸福。","xianji":[["家宅","安"],["自身","吉"],["求财","顺"],["交易","利"],["婚姻","成"],["六甲","女"],["行人","至"],["田蚕","熟"],["六畜","旺"],["寻人","至"],["公讼","有理"],["移徙","吉"],["失物","凶"],["疾病","即痊愈"],["山坟","大吉"]]},{"n":62,"title":"唐僧得道","level":"中签","gong":"寅宫","poem":["晨昏全赖佛扶持","须是逢危却不危","若得贵人相引处","那时财帛亦相随"],"shiyi":"此卦神佛暗佑之象。凡事忍耐大吉也。","jie":"平平稳稳。四方名显。改旧从新。亦无凶险。","xianji":[["家宅","安"],["自身","吉"],["求财","西方"],["交易","遂"],["婚姻","成"],["六甲","祈福"],["行人","阻"],["田蚕","七分"],["六畜","利"],["寻人","西方"],["公讼","亏"],["移徙","守旧"],["失物","见"],["疾病","祈福"],["山坟","吉"]]},{"n":63,"title":"女娲氏炼石","level":"中签","gong":"卯宫","poem":["昔然行船失了针","今朝依旧海中寻","若然寻得原针在","也费工夫也费心"],"shiyi":"此卦海中寻针之象。凡事费心劳力也。","jie":"福是禄基。禄是福种。说得分明。切宜守谨。","xianji":[["家宅","欠利"],["自身","谨防"],["求财","有"],["交易","成"],["婚姻","不合"],["六甲","阻"],["行人","滞"],["田蚕","吉"],["六畜","莫养"],["寻人","难"],["公讼","宜和"],["移徙","宜迁"],["失物","凶"],["疾病","难痊"],["山坟","暂安"]]},{"n":64,"title":"马前覆水","level":"下签","gong":"卯宫","poem":["游鱼却在碧波池","撞遭罗网四边围","思量无计翻身出","事到头来惹事非"],"shiyi":"此卦鱼遭罗网之象。凡事亦宜提防也。","jie":"屋下安身。祸从天降。早觉先防。免遭灾殃。","xianji":[["家宅","凶"],["自身","险"],["求财","虚"],["交易","中平"],["婚姻","不合"],["六甲","惊"],["行人","有阻"],["田蚕","损"],["六畜","衰"],["寻人","杳"],["公讼","亏"],["移徙","吉"],["失物","凶"],["疾病","有灾险"],["山坟","宜改"]]},{"n":65,"title":"孙膑困庞涓","level":"下签","gong":"卯宫","poem":["眼前欢喜未为欢","亦不危时亦不安","割肉补疮为甚事","不如守旧待时光"],"shiyi":"此卦割肉成疮之象。凡事只宜守旧待时。","jie":"知止则止。知宽自宽。割自身肉。疾痛一般。","xianji":[["家宅","不安"],["自身","口舌"],["求财","不利"],["交易","小人"],["婚姻","不长"],["六甲","有惊"],["行人","阻"],["田蚕","损"],["六畜","损"],["寻人","招非"],["公讼","亏"],["移徙","守旧"],["失物","难寻"],["疾病","反复"],["山坟","不利"]]},{"n":66,"title":"霸王被困","level":"下签","gong":"卯宫","poem":["路险马嬴人行急","失群军卒困相当","滩高风浪船棹破","日暮花残天降霜"],"shiyi":"此卦船破下滩之象。凡事险阻提防也。","jie":"守旧待时。安静无咎。不用求谋。自在悠游。","xianji":[["家宅","忧疑"],["自身","灾耗"],["求财","破失"],["交易","败"],["婚姻","不长"],["六甲","危险"],["行人","阻"],["田蚕","损"],["六畜","损"],["寻人","杳"],["公讼","亏"],["移徙","莫动"],["失物","难"],["疾病","即设送"],["山坟","不利"]]},{"n":67,"title":"金精试窦儿","level":"上签","gong":"卯宫","poem":["一条金线秤君心","无减无增无重轻","为人平生心正直","文章全具艺光明"],"shiyi":"此卦心平正直之象。凡事平稳无凶也。","jie":"心平正直。到底清平。只依本份。天下太平。","xianji":[["家宅","安"],["自身","平"],["求财","守慎"],["交易","稳"],["婚姻","合"],["六甲","男"],["行人","有信"],["田蚕","稳"],["六畜","安"],["寻人","迟"],["公讼","和"],["移徙","守旧"],["失物","见"],["疾病","禳星"],["山坟","平"]]},{"n":68,"title":"汾阳祝寿","level":"中签","gong":"卯宫","poem":["门廷吉庆喜非常","积善之门大吉昌","婚姻田蚕诸事遂","病逢妙药即安康"],"shiyi":"此卦春梦百花之象。凡事遇贵人大吉也。","jie":"春深日暖。百花自开。事莫迟疑。从人显达。","xianji":[["家宅","旺"],["自身","安"],["求财","春旺"],["交易","遂"],["婚姻","成"],["六甲","防惊"],["行人","到"],["田蚕","利"],["六畜","旺"],["寻人","至"],["公讼","胜"],["移徙","如意"],["失物","急寻"],["疾病","安"],["山坟","大吉"]]},{"n":69,"title":"梅开二度","level":"中签","gong":"辰宫","poem":["冬来岭上一枝梅","叶落枝枯终不摧","但得阳春悄急至","依然还我作花魁"],"shiyi":"此卦梅花占魁之象。凡事宜迟则吉也。","jie":"一箭射空。当空不空。待等春来。彩在其中。","xianji":[["家宅","欠利"],["自身","作福"],["求财","谨慎"],["交易","待时"],["婚姻","迟成"],["六甲","春实秋虚"],["行人","迟至"],["田蚕","旺"],["田蚕","旺"],["六畜","旺"],["寻人","见"],["公讼","亏"],["移徙","如意"],["失物","东方"],["疾病","虚惊"],["山坟","宜改"]]},{"n":70,"title":"李密反唐","level":"下签","gong":"辰宫","poem":["朝朝恰似采花蜂","飞出西南又走东","春尽花残无觅处","此心不变旧行踪"],"shiyi":"此卦蜜蜂采花之象。凡事劳心费力也。","jie":"无觅春色。久雨不晴。求谋动用。不如安静。","xianji":[["家宅","口舌"],["自身","小人"],["求财","破耗"],["交易","反复"],["婚姻","不长"],["六甲","虚花"],["行人","杳"],["田蚕","损"],["六畜","损"],["寻人","无踪"],["公讼","亏"],["移徙","守旧"],["失物","空"],["疾病","有阻"],["山坟","改"]]},{"n":71,"title":"文君访相如","level":"中签","gong":"辰宫","poem":["认知苍龙下九衢","女子当年嫁二夫","自是一弓架两箭","欲恐龙马不安居"],"shiyi":"此卦一弓架两箭之象。凡事再合则吉也。","jie":"不出重重。事由天命。振六中开。切宜谨守。","xianji":[["家宅","损失"],["自身","是非"],["求财","劳力"],["交易","谨防"],["婚姻","再合"],["六甲","先虚后实"],["行人","阻"],["田蚕","晚收"],["六畜","损"],["寻人","见"],["公讼","亏"],["移徙","改"],["失物","见"],["疾病","禳星"],["山坟","改"]]},{"n":72,"title":"王莽求贤","level":"中签","gong":"辰宫","poem":["养蜂须用求他蜜","只怕遭触尾上针","须是眼前有异路","暗里深如荆棘林"],"shiyi":"此卦结蜂采蜜之象。凡事劳心费力也。","jie":"事须仔细。不用强求。结蜂采蜜。有甚来由。","xianji":[["家宅","欠利"],["自身","防"],["求财","阻"],["交易","迟"],["婚姻","阻隔"],["六甲","虚惊"],["行人","迟"],["田蚕","少收"],["六畜","少收"],["寻人","难"],["公讼","亏"],["移徙","莫动"],["失物","凶"],["疾病","设送"],["山坟","败"]]},{"n":73,"title":"陈桥兵变","level":"上签","gong":"巳宫","poem":["春来雷震百虫鸣","番身一转离泥中","始知出入还来往","一朝变化便成龙"],"shiyi":"此卦雷发百虫之象。凡事遇贵人吉兆也。","jie":"雷发时转。出入两存。一朝变化。直到天门。","xianji":[["家宅","祈福"],["自身","平常"],["求财","春利"],["交易","贵人"],["婚姻","成合"],["六甲","男"],["行人","到"],["田蚕","早生"],["六畜","春利"],["寻人","见"],["公讼","胜"],["移徙","吉"],["失物","在"],["疾病","险阻"],["山坟","吉"]]},{"n":74,"title":"秦败擒三帅","level":"下签","gong":"巳宫","poem":["似鹄飞来自入笼","欲得番身却不通","南北东西都难出","此卦诚恐恨无穹"],"shiyi":"此卦似鹄投笼之象。凡事多虚少实也。","jie":"进身不得。退步为难。低头直去。悉在其中。","xianji":[["家宅","不安"],["自身","困滞"],["求财","小人"],["交易","破耗"],["婚姻","刑伤"],["六甲","刑劫"],["行人","阻"],["田蚕","缺"],["六畜","瘟"],["寻人","杳"],["公讼","祸"],["移徙","不利"],["失物","凶"],["疾病","延"],["山坟","绝"]]},{"n":75,"title":"伍员夜出昭关","level":"中签","gong":"午宫","poem":["恰如抱虎过高山","战战竞竞胆碎寒","不觉忽然从好事","切须保守一身安"],"shiyi":"此卦抱虎过山之象。凡事险凶惊恐也。","jie":"危危险险。前程有阻。若问求谋。到底辛苦。","xianji":[["家宅","祈保"],["自身","提防"],["求财","谨慎"],["交易","滞"],["婚姻","难顺"],["六甲","有惊"],["行人","阻"],["田蚕","五分"],["六畜","损"],["寻人","杳"],["公讼","亏"],["移徙","守"],["失物","难"],["疾病","祭虎"],["山坟","凶"]]},{"n":76,"title":"洪武看牛","level":"中签","gong":"午宫","poem":["鱼龙混杂意相同","耐守深潭待运通","不觉一朝头耸出","禹门一跳过龙宫"],"shiyi":"此卦鱼龙未变之象。凡事待时至可也。","jie":"虽是滋基。也要待时。营谋自本。切莫妄为。","xianji":[["家宅","平安"],["自身","康泰"],["求财","有"],["交易","待时"],["婚姻","迟合"],["六甲","生男"],["行人","迟"],["田蚕","晚丰"],["六畜","尾利"],["寻人","未遇"],["公讼","延"],["移徙","守旧"],["失物","远"],["疾病","阻"],["山坟","发"]]},{"n":77,"title":"捧璧归赵","level":"中签","gong":"午宫","poem":["梦中说得是多财","声名云外总虚来","水远山遥难信实","贵人指点笑颜开"],"shiyi":"此卦梦中得宝之象。凡事虚多少实也。","jie":"如梦说梦。声名莫望。只待好时。贵人指示。","xianji":[["家宅","祈福"],["自身","阻"],["求财","虚"],["交易","难成"],["婚姻","不合"],["六甲","虚"],["行人","迟