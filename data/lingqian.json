],["婚姻","迟"],["六甲","生女"],["行人","阻"],["田蚕","平稳"],["六畜","平稳"],["寻人","难"],["公讼","和"],["移徙","守旧"],["失物","难"],["疾病","设送"],["山坟","改"]]},{"n":84,"title":"庄子试妻","level":"下签","gong":"未宫","poem":["因名丧德如何事","切恐吉中变化凶","酒醉不知何处去","青松影里梦朦胧"],"shiyi":"此卦寒鱼离水之象。凡事不可移动也。","jie":"寒鱼离水。美中不足。若问营谋。不如莫起。","xianji":[["家宅","平吉"],["自身","利安"],["求财","不平"],["交易","诸祭"],["婚姻","事解"],["六甲","煞旺"],["行人","未至"],["田蚕","平"],["六畜","平"],["寻人","—"],["公讼","变"],["移徙","守旧"],["失物","无"],["疾病","反复"],["山坟","凶"]]},{"n":85,"title":"韩文公遇雪","level":"中签","gong":"申宫","poem":["云闇雾罩山前路","万物圆中月再圆","若得诗书沉梦醒","贵人指引步天台"],"shiyi":"此卦春尽花开之象。凡事主后改变也。","jie":"老者用求。春残再开。欲求名利。晚遇横财。","xianji":[["家宅","欠利"],["自身","谨慎"],["求财","着力"],["交易","平"],["婚姻","迟"],["六甲","女"],["行人","阻"],["田蚕","好"],["六畜","好"],["寻人","难"],["公讼","反复"],["移徙","更新"],["失物","凶病"],["疾病","延滞"],["山坟","宜改"]]},{"n":86,"title":"商辂中三元","level":"上签","gong":"申宫","poem":["春来花发映阳台","万里车来进宝财","若得禹门三级浪","恰如平地一声雷"],"shiyi":"此卦上朝见帝之象。凡事太吉大利也。","jie":"朝帝受职。如贫得宝。谋望从心。卦中第一。","xianji":[["家宅","有喜"],["自身","吉"],["求财","有"],["交易","春吉"],["婚姻","成"],["六甲","顺意"],["行人","喜讯"],["田蚕","利"],["六畜","旺"],["寻人","回"],["公讼","胜"],["移徙","可"],["失物","在"],["疾病","安"],["山坟","吉"]]},{"n":87,"title":"咬金探地穴","level":"中签","gong":"申宫","poem":["人行半岭日西山","竣岭崖岩未可安","仰望上天为护佑","此身犹在太平间"],"shiyi":"此卦淘沙见金之象。凡事有贵人之兆也。","jie":"凿石见玉。淘沙见金。须要着力。只是劳心。","xianji":[["家宅","祈福"],["自身","欠利"],["求财","劳心"],["交易","谨慎"],["婚姻","有阻"],["六甲","虚"],["行人","迟"],["田蚕","平稳"],["六畜","平稳"],["寻人","未遇"],["公讼","亏"],["移徙","守"],["失物","凶"],["疾病","阻"],["山坟","不阻"]]},{"n":88,"title":"庞洪畏包公","level":"中签","gong":"酉宫","poem":["林为一虎在当门","须是有威不害人","分明说是无防事","忧恼迟疑恐惊心"],"shiyi":"此卦林木虎有威之象。凡事虚惊少实也。","jie":"炉头点雪。似耳边风。可宜作福。后吉前凶。","xianji":[["家宅","不安"],["自身","口舌"],["求财","小人"],["交易","不利"],["婚姻","不合"],["六甲","虚险"],["行人","阻"],["田蚕","损"],["六畜","损"],["寻人","杳"],["公讼","亏"],["移徙","守旧"],["失物","凶"],["疾病","祭虎"],["山坟","凶"]]},{"n":89,"title":"智服姜维","level":"上签","gong":"酉宫","poem":["出入营谋大吉昌","似玉无瑕石里藏","若得贵人来指引","斯时得宝喜风光"],"shiyi":"此卦石藏珍宝之象。凡事称心大吉也。","jie":"如石藏玉。贵人指示。得祗称心。欢怀得意。","xianji":[["家宅","吉利"],["自身","康泰"],["求财","遂"],["交易","成"],["婚姻","成就"],["六甲","生男"],["行人","动"],["田蚕","着力"],["六畜","勤理"],["寻人","见"],["公讼","胜"],["移徙","吉"],["失物","在"],["疾病","安"],["山坟","吉"]]},{"n":90,"title":"苇佩遇仙","level":"上签","gong":"酉宫","poem":["忽言一信向天飞","泰山宝贝满船归","若问路途成好事","前头仍有贵人推"],"shiyi":"此卦功名成就之象。凡事宜进大吉也。","jie":"若问功名。前有贵人。更添喜气。财禄丰盈。","xianji":[["家宅","若前"],["自身","吉随"],["求财","佳顺"],["交易","诸求"],["婚姻","事之"],["六甲","添孙"],["行人","财更"],["田蚕","功贵"],["六畜","问有"],["寻人","名人"],["公讼","盈气"],["移徙","吉"],["失物","在"],["疾病","安"],["山坟","丰喜"]]},{"n":91,"title":"三战吕布","level":"中签","gong":"酉宫","poem":["好展愁眉出众来","前途改变喜多财","一条大路如天阔","凡有施财尽畅怀"],"shiyi":"此卦前途显达之象。凡事通泰大吉也。","jie":"一条大路。可向前行。心中用事。只可向前。","xianji":[["家宅","心只"],["自身","路行"],["求财","大前"],["交易","一可"],["婚姻","条向"],["六甲","事顺"],["行人","诸顺"],["田蚕","用向"],["六畜","中可"],["寻人","事前"],["公讼","意昌"],["移徙","守旧"],["失物","凶"],["疾病","延"],["山坟","如吉"]]},{"n":92,"title":"蔡卿报恩","level":"上签","gong":"酉宫","poem":["自幼为商任设谋","财禄盈丰不用求","若是双身谋望事","秀才出去状元回"],"shiyi":"此卦自小为商之象。凡事勤俭无忧也。","jie":"自小至大。无阻无碍。作意营谋。功名顺遂。","xianji":[["家宅","安"],["自身","泰"],["求财","顺遂"],["交易","胜"],["婚姻","合"],["六甲","生男"],["行人","动"],["田蚕","半收"],["六畜","旺"],["寻人","见"],["公讼","胜"],["移徙","如意"],["失物","在"],["疾病","即安"],["山坟","大吉"]]},{"n":93,"title":"高君保招亲","level":"中签","gong":"戌宫","poem":["鸾凤翔毛雨淋漓","当时却被雀儿欺","终教一日云开达","依旧还君整羽衣"],"shiyi":"此卦鸾凤被雨之象。凡事待时大利也。","jie":"小人日盛。君子莫为。只宜守己。待时施为。","xianji":[["家宅","欠利"],["自身","谨防"],["求财","阻"],["交易","待时"],["婚姻","迟滞"],["六甲","有虚"],["行人","留连"],["田蚕","晚"],["六畜","损"],["寻人","难"],["公讼","亏"],["移徙","守旧"],["失物","凶"],["疾病","延"],["山坟","改"]]},{"n":94,"title":"伯牙访友","level":"下签","gong":"戌宫","poem":["君子莫体小人为","事若差池惹是非","琴鸣须用知音听","守常安静得依稀"],"shiyi":"此卦要逢知己之象。凡事守常则吉也。","jie":"知音方许。闲事莫理。待得贵人。无不欢喜。","xianji":[["家宅","慎出"],["自身","小人"],["求财","待时"],["交易","谨慎"],["婚姻","宜迟"],["六甲","女"],["行人","动"],["田蚕","少"],["六畜","损"],["寻人","勤"],["公讼","和"],["移徙","去"],["失物","速寻"],["疾病","阻隔"],["山坟","不利"]]},{"n":95,"title":"曹丕称帝","level":"中签","gong":"戌宫","poem":["志气功业在朝朝","今将酒色不胜饶","若见金鸡报君语","钱财福禄与君招"],"shiyi":"此卦志气功名之象。凡事守常大吉也。","jie":"志气心动。守己未迟。金鸡报诺。无不欢喜。","xianji":[["家宅","祈保"],["自身","中平"],["求财","劳心"],["交易","早断"],["婚姻","有成"],["六甲","安"],["行人","留连"],["田蚕","晚成"],["六畜","成"],["寻人","难"],["公讼","急断"],["移徙","守"],["失物","远"],["疾病","延缠"],["山坟","吉"]]},{"n":96,"title":"窦燕山积善","level":"上签","gong":"戌宫","poem":["巍峨宝塔不寻常","八面玲珑尽放光","劝君立志勤顶礼","作善苍天降福祥"],"shiyi":"此卦福德现身之象。凡事大吉利也。","jie":"这些福份。众人皆有。不用心忙。福德前定。","xianji":[["家宅","许愿"],["自身","许经"],["求财","正胜"],["交易","大吉"],["婚姻","好合"],["六甲","喜"],["行人","动"],["田蚕","平稳"],["六畜","欠利"],["寻人","遇"],["公讼","和"],["移徙","吉"],["失物","见"],["疾病","禳星"],["山坟","平"]]},{"n":97,"title":"六出祁山","level":"中签","gong":"亥宫","poem":["当风点烛空疏影","恍惚铺成镜里花","累被儿童求收拾","怎知只是幻浮槎"],"shiyi":"此卦当风点烛之象。凡事虚名不利也。","jie":"富贵在天。贫穷是命。不用求谋。皆是前定。","xianji":[["家宅","祈福"],["自身","谨慎"],["求财","得利"],["交易","慎重"],["婚姻","中平"],["六甲","有惊"],["行人","杳"],["田蚕","损"],["六畜","损"],["寻人","无踪"],["公讼","亏"],["移徙","守旧"],["失物","凶"],["疾病","犯阴"],["山坟","改"]]},{"n":98,"title":"吉平遇难","level":"下签","gong":"亥宫","poem":["出入求谋事宜迟","只恐闲愁惹是非","如鸟飞入罗网里","相逢能有几多时"],"shiyi":"此卦守旧随缘之象。凡事不如意主凶也。","jie":"守旧随时。待贵人至。若问诸般。主事定迟。","xianji":[["家宅","忧疑"],["自身","小人"],["求财","破"],["交易","损失"],["婚姻","不长"],["六甲","刑损"],["行人","困"],["田蚕","损"],["六畜","损"],["寻人","杳"],["公讼","亏"],["移徙","勿动"],["失物","凶"],["山坟","绝"],["疾病","犯罗网"]]},{"n":99,"title":"陶三春挂帅","level":"下签","gong":"亥宫","poem":["勒马持鞭直过来","半有忧危半有灾","恰似遭火焚烧屋","天降时雨荡成灰"],"shiyi":"此卦半忧半喜之象。凡事只宜行善也。","jie":"终身劳力。莫管是非。枷锁临时。怨尤自至。","xianji":[["家宅","祈保"],["自身","守慎"],["求财","破"],["交易","阻"],["婚姻","刑克"],["六甲","险"],["行人","困"],["田蚕","损"],["六畜","损"],["寻人","招非"],["公讼","亏"],["移徙","守旧"],["失物","凶"],["疾病","忧危"],["山坟","败"]]},{"n":100,"title":"三教谈道","level":"下签","gong":"亥宫","poem":["佛神灵通与君知","痴人说事转昏迷","老人求得灵签去","不如守旧待时来"],"shiyi":"此卦守常勿动之象。凡事宜待时吉也。","jie":"完满灵签。尽报君知。依旧勿动。待等时至。","xianji":[],"note":"此是满签。诸事不利。大作福力。可保平安。"}]